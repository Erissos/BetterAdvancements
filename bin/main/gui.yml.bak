tier:
  title: "<#f8fafc><bold>{tier_name}</bold></#f8fafc> <#64748b>// Route Map</#64748b>"
  frame:
    material: BLACK_STAINED_GLASS_PANE
    name: "<#020617> "
  background:
    material: GRAY_STAINED_GLASS_PANE
    name: "<#111827> "
    glow: false
  blocked-slots: [4, 45, 46, 47, 48, 49, 50, 51, 52, 53]
  overview:
    slot: 4
    glow: true
    title: "<#fde68a><bold>{tier_name} Overview</bold></#fde68a>"
    lore:
      - "<#94a3b8>Completion:</#94a3b8> <#facc15>{completion}%</#facc15>"
      - "<#94a3b8>Total Nodes:</#94a3b8> <#f8fafc>{total}</#f8fafc>"
      - "<#94a3b8>Unlocked Nodes:</#94a3b8> <#4ade80>{unlocked}</#4ade80>"
      - "<#94a3b8>Rare Clears:</#94a3b8> <#c084fc>{rare}</#c084fc>"
      - ""
      - "<#475569>Use nodes and links below to read the dependency chain cleanly.</#475569>"
  node:
    hidden-title: "<#94a3b8><bold>Hidden Node</bold></#94a3b8>"
    hidden-description: "<#475569>This objective is concealed until its unlock condition is met.</#475569>"
    materials:
      hidden: BLACK_STAINED_GLASS_PANE
      completed: LIME_STAINED_GLASS_PANE
      locked: GRAY_STAINED_GLASS_PANE
    lore:
      - ""
      - "<#cbd5e1>{description}</#cbd5e1>"
      - ""
      - "<#fde68a>Objective:</#fde68a> <#f8fafc>{objective}</#f8fafc>"
      - "<#86efac>Progress:</#86efac> <#f8fafc>{progress}</#f8fafc><#64748b>/</#64748b><#facc15>{target}</#facc15>"
      - "<#67e8f9>Category:</#67e8f9> <#f8fafc>{category}</#f8fafc>"
      - "<#c084fc>Rarity:</#c084fc> <#f8fafc>{rarity}</#f8fafc>"
      - "<#4ade80>Rewards:</#4ade80> <#f8fafc>{rewards}</#f8fafc>"
      - "<#fda4af>Points:</#fda4af> <#f8fafc>{points}</#f8fafc>"
    requires-format: "<#fb7185>Requires:</#fb7185> <#f8fafc>{requirements}</#f8fafc>"
    unlocks-format: "<#67e8f9>Unlocks:</#67e8f9> <#f8fafc>{unlocks}</#f8fafc>"
    state:
      completed: "<#4ade80><bold>State:</bold> Completed</#4ade80>"
      unlocked: "<#facc15><bold>State:</bold> Unlocked</#facc15>"
      locked: "<#94a3b8><bold>State:</bold> Waiting on dependencies</#94a3b8>"
  connectors:
    title-completed: "<#4ade80><bold>{direction} Completed Link</bold></#4ade80>"
    title-locked: "<#67e8f9><bold>{direction} Dependency Link</bold></#67e8f9>"
    detail-completed: "<#94a3b8>This route is already satisfied.</#94a3b8>"
    detail-locked: "<#94a3b8>This route still controls the next unlock.</#94a3b8>"
    direction-lore: "<#475569>Direction marker: {direction}</#475569>"
    materials:
      completed: LIME_STAINED_GLASS_PANE
      vertical: CYAN_STAINED_GLASS_PANE
      horizontal-forward: LIGHT_BLUE_STAINED_GLASS_PANE
      horizontal-back: BLUE_STAINED_GLASS_PANE
    symbols:
      right: ">"
      left: "<"
      down: "v"
      up: "^"
      point: "*"
  navigation:
    previous:
      slot: 45
      active:
        material: ARROW
        glow: false
        title: "<#67e8f9><bold>Previous Tier: {tier_name}</bold></#67e8f9>"
        lore:
          - "<#94a3b8>Move back one lane and inspect earlier dependencies.</#94a3b8>"
      empty:
        material: BARRIER
        glow: false
        title: "<#94a3b8><bold>No Previous Tier</bold></#94a3b8>"
        lore:
          - "<#475569>You are already viewing the opening lane.</#475569>"
    legend-completed:
      slot: 46
      material: LIME_STAINED_GLASS_PANE
      glow: false
      title: "<#4ade80><bold>Completed</bold></#4ade80>"
      lore:
        - "<#94a3b8>Nodes that are fully cleared and archived.</#94a3b8>"
    legend-unlocked:
      slot: 47
      material: LIGHT_BLUE_STAINED_GLASS_PANE
      glow: false
      title: "<#67e8f9><bold>Unlocked</bold></#67e8f9>"
      lore:
        - "<#94a3b8>Nodes that can be progressed immediately.</#94a3b8>"
    legend-locked:
      slot: 48
      material: GRAY_STAINED_GLASS_PANE
      glow: false
      title: "<#94a3b8><bold>Locked</bold></#94a3b8>"
      lore:
        - "<#94a3b8>Nodes still waiting for earlier requirements.</#94a3b8>"
    back:
      slot: 49
      material: BARRIER
      glow: false
      title: "<#fb7185><bold>Back to Command Deck</bold></#fb7185>"
      lore:
        - "<#94a3b8>Return to the main control menu.</#94a3b8>"
    horizontal:
      slot: 50
      title: "<#67e8f9><bold>Horizontal Link</bold></#67e8f9>"
      detail: "<#94a3b8>Shows dependencies inside the same row.</#94a3b8>"
    vertical:
      slot: 51
      title: "<#67e8f9><bold>Vertical Link</bold></#67e8f9>"
      detail: "<#94a3b8>Shows dependencies that continue into another row.</#94a3b8>"
    focus:
      slot: 52
      material: COMPASS
      glow: true
      title: "<#fde68a><bold>Route Focus</bold></#fde68a>"
      active-lore:
        - "<#94a3b8>Priority Node:</#94a3b8> <#f8fafc>{target}</#f8fafc>"
        - "<#94a3b8>Goal:</#94a3b8> <#4ade80>{goal}</#4ade80>"
        - "<#94a3b8>Category:</#94a3b8> <#fde68a>{category}</#fde68a>"
        - ""
        - "<#475569>Best immediate route target in this lane.</#475569>"
      empty-lore:
        - "<#94a3b8>No immediate focus node exists in this lane.</#94a3b8>"
        - "<#475569>The lane is either complete or blocked elsewhere.</#475569>"
    next:
      slot: 53
      active:
        material: ARROW
        glow: false
        title: "<#fde68a><bold>Next Tier: {tier_name}</bold></#fde68a>"
        lore:
          - "<#94a3b8>Move forward to the next route layer.</#94a3b8>"
      empty:
        material: BARRIER
        glow: false
        title: "<#94a3b8><bold>No Next Tier</bold></#94a3b8>"
        lore:
          - "<#475569>You are already at the final showcase lane.</#475569>"

