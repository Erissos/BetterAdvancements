main:
  title: "<#f8fafc><bold>Better Advancements</bold></#f8fafc> <#00bfff>// Dashboard Core</#00bfff>"
  frame:
    material: BLACK_STAINED_GLASS_PANE
    name: "<#050816> "
  background:
    material: GRAY_STAINED_GLASS_PANE
    name: "<#1f1f1f> "
    glow: false
  fillers:
    header-left:
      material: LIGHT_BLUE_STAINED_GLASS_PANE
      name: "<#0d2d3a> "
      slots: [10, 12]
    header-right:
      material: CYAN_STAINED_GLASS_PANE
      name: "<#062f33> "
      slots: [14, 16]
    header-center:
      material: BLUE_STAINED_GLASS_PANE
      name: "<#10253d> "
      slots: [11, 15]
    bridge:
      material: LIGHT_GRAY_STAINED_GLASS_PANE
      name: "<#2b3443> "
      slots: [22]
    footer-left:
      material: CYAN_STAINED_GLASS_PANE
      name: "<#073840> "
      slots: [37, 38, 39]
    footer-right:
      material: PURPLE_STAINED_GLASS_PANE
      name: "<#2a2149> "
      slots: [41, 42, 43]
  profile:
    slot: 4
    glow: true
    title: "<#00ffc6><bold>Profile Pulse</bold></#00ffc6>"
    lore:
      - "<#8a9aaf>Player:</#8a9aaf> <#f8fafc>{player}</#f8fafc>"
      - "<#8a9aaf>Network Clear:</#8a9aaf> <#00ffc6>{completion}%</#00ffc6>"
      - "<#8a9aaf>Total Score:</#8a9aaf> <#00bfff>{points}</#00bfff>"
      - "<#8a9aaf>Top Lane:</#8a9aaf> <#7a5fff>{highest_tier}</#7a5fff>"
      - ""
      - "<#52606f>Compact identity card for current pace, score and route depth.</#52606f>"
  next-target:
    slot: 11
    active:
      material: COMPASS
      glow: true
      title: "<#00bfff><bold>Focus Route</bold></#00bfff>"
      lore:
        - "<#8a9aaf>Objective:</#8a9aaf> <#f8fafc>{target}</#f8fafc>"
        - "<#8a9aaf>Tier:</#8a9aaf> <#7a5fff>{tier}</#7a5fff>"
        - "<#8a9aaf>Category:</#8a9aaf> <#00ffc6>{category}</#00ffc6>"
        - "<#8a9aaf>Goal:</#8a9aaf> <#f8fafc>{goal}</#f8fafc>"
        - ""
        - "<#52606f>Click to enter the best unfinished lane immediately.</#52606f>"
    empty:
      material: TOTEM_OF_UNDYING
      glow: true
      title: "<#00ffc6><bold>Network Cleared</bold></#00ffc6>"
      lore:
        - "<#8a9aaf>Every configured advancement is complete.</#8a9aaf>"
        - "<#8a9aaf>This profile is currently in showcase state.</#8a9aaf>"
        - ""
        - "<#52606f>Use the tier lane below to review completed branches.</#52606f>"
  challenge:
    slot: 15
    material: CLOCK
    glow: true
    title: "<#7a5fff><bold>Live Challenges</bold></#7a5fff>"
    empty-lore:
      - "<#8a9aaf>No daily or weekly rotation is active right now.</#8a9aaf>"
      - "<#52606f>The board fills automatically on the next rotation window.</#52606f>"
    entry-title: "<#00ffc6>{type}</#00ffc6> <#64748b>/</#64748b> <#f8fafc>{title}</#f8fafc>"
    entry-description: "<#8a9aaf>{description}</#8a9aaf>"
    entry-reward: "<#00bfff>Reward:</#00bfff> <#f8fafc>{reward} points</#f8fafc>"
    footer-lore:
      - ""
      - "<#52606f>Open the full board for rotation details and progress state.</#52606f>"
  tiers:
    order: [novice, skilled, expert, master, mythic]
    auto-slots: [19, 20, 21, 23, 24]
    state:
      completed:
        - ""
        - "<#00ffc6><bold>Status:</bold> Archived</#00ffc6>"
        - "<#52606f>This lane is fully cleared and stored in profile history.</#52606f>"
      locked:
        - ""
        - "<#ff6b8a><bold>Status:</bold> Locked</#ff6b8a>"
        - "<#8a9aaf>Finish <#f8fafc>{previous_tier}</#f8fafc> before this lane opens.</#8a9aaf>"
      available:
        - ""
        - "<#00bfff><bold>Status:</bold> Live</#00bfff>"
        - "<#52606f>This lane contains objectives you can push right now.</#52606f>"
    novice:
      aliases: [TIER_1, novice, starter]
      weight: 1
      display-name: "Novice"
      icon: GRASS_BLOCK
      name: "<#00ffc6><bold>Novice Lane</bold></#00ffc6>"
      lore:
        - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completion}%</#f8fafc>"
        - "<#8a9aaf>Unlocked:</#8a9aaf> <#f8fafc>{unlocked}/{total}</#f8fafc>"
        - "<#8a9aaf>Rare Clears:</#8a9aaf> <#7a5fff>{rare}</#7a5fff>"
        - "<#52606f>Entry systems, first rewards and baseline route pressure.</#52606f>"
    skilled:
      aliases: [TIER_2, skilled]
      weight: 2
      display-name: "Skilled"
      icon: IRON_PICKAXE
      name: "<#00bfff><bold>Skilled Lane</bold></#00bfff>"
      lore:
        - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completion}%</#f8fafc>"
        - "<#8a9aaf>Unlocked:</#8a9aaf> <#f8fafc>{unlocked}/{total}</#f8fafc>"
        - "<#8a9aaf>Rare Clears:</#8a9aaf> <#7a5fff>{rare}</#7a5fff>"
        - "<#52606f>Broader mechanics, stronger rewards and wider dependencies.</#52606f>"
    expert:
      aliases: [TIER_3, expert]
      weight: 3
      display-name: "Expert"
      icon: DIAMOND
      name: "<#7ad7ff><bold>Expert Lane</bold></#7ad7ff>"
      lore:
        - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completion}%</#f8fafc>"
        - "<#8a9aaf>Unlocked:</#8a9aaf> <#f8fafc>{unlocked}/{total}</#f8fafc>"
        - "<#8a9aaf>Rare Clears:</#8a9aaf> <#7a5fff>{rare}</#7a5fff>"
        - "<#52606f>Dense chains, higher load and more deliberate pathing.</#52606f>"
    master:
      aliases: [TIER_4, master]
      weight: 4
      display-name: "Master"
      icon: NETHERITE_INGOT
      name: "<#7a5fff><bold>Master Lane</bold></#7a5fff>"
      lore:
        - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completion}%</#f8fafc>"
        - "<#8a9aaf>Unlocked:</#8a9aaf> <#f8fafc>{unlocked}/{total}</#f8fafc>"
        - "<#8a9aaf>Rare Clears:</#8a9aaf> <#00ffc6>{rare}</#00ffc6>"
        - "<#52606f>High-pressure routing, prestige setup and premium rewards.</#52606f>"
    mythic:
      aliases: [TIER_5, mythic]
      weight: 5
      display-name: "Mythic"
      icon: DRAGON_HEAD
      name: "<#c39eff><bold>Mythic Lane</bold></#c39eff>"
      lore:
        - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completion}%</#f8fafc>"
        - "<#8a9aaf>Unlocked:</#8a9aaf> <#f8fafc>{unlocked}/{total}</#f8fafc>"
        - "<#8a9aaf>Rare Clears:</#8a9aaf> <#00ffc6>{rare}</#00ffc6>"
        - "<#52606f>Late-game showcase routes tuned for full-clear grinders.</#52606f>"
  stats:
    slot: 28
    material: NETHER_STAR
    glow: false
    title: "<#00bfff><bold>Analytics</bold></#00bfff>"
    lore:
      - "<#8a9aaf>Open the clean deep-view progression panel.</#8a9aaf>"
      - "<#52606f>Tier spread, category density and current route state.</#52606f>"
  leaderboard:
    slot: 29
    material: PLAYER_HEAD
    glow: false
    title: "<#00ffc6><bold>Leaderboard</bold></#00ffc6>"
    lore:
      - "<#8a9aaf>Review global and session standings.</#8a9aaf>"
      - "<#52606f>Top profiles are surfaced as spotlight cards.</#52606f>"
  categories:
    slot: 30
    material: SPYGLASS
    glow: true
    title: "<#7a5fff><bold>Category Matrix</bold></#7a5fff>"
    lore:
      - "<#8a9aaf>Active Categories:</#8a9aaf> <#f8fafc>{categories}</#f8fafc>"
      - "<#8a9aaf>Total Clears:</#8a9aaf> <#00ffc6>{completed}</#00ffc6>"
      - ""
      - "<#52606f>Open the curated category dashboard for cleaner routing.</#52606f>"
  season:
    slot: 32
    material: RECOVERY_COMPASS
    glow: true
    title: "<#00bfff><bold>Season Pulse</bold></#00bfff>"
    lore:
      - "<#8a9aaf>Season:</#8a9aaf> <#f8fafc>{season}</#f8fafc>"
      - "<#8a9aaf>Season Points:</#8a9aaf> <#00ffc6>{season_points}</#00ffc6>"
      - "<#8a9aaf>Milestones:</#8a9aaf> <#f8fafc>{reward_count}</#f8fafc>"
      - ""
      - "<#52606f>Rewards, seasonal podium and forecasted thresholds.</#52606f>"
  prestige:
    slot: 33
    material: NETHERITE_UPGRADE_SMITHING_TEMPLATE
    glow: true
    title: "<#ff88c2><bold>Prestige</bold></#ff88c2>"
    lore:
      - "<#8a9aaf>Prestige:</#8a9aaf> <#f8fafc>{prestige}</#f8fafc>"
      - "<#8a9aaf>Completion:</#8a9aaf> <#f8fafc>{completed}/{total}</#f8fafc>"
      - "<#8a9aaf>Bonus:</#8a9aaf> <#00ffc6>{bonus}</#00ffc6>"
      - ""
      - "<#52606f>Inspect reset impact and long-term profile gain.</#52606f>"
  settings:
    slot: 34
    material: COMPARATOR
    glow: true
    title: "<#7a5fff><bold>Settings</bold></#7a5fff>"
