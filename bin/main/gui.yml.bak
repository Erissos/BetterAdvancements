  title: "<#f8fafc><bold>Prestige Control</bold></#f8fafc> <#64748b>// Reset Authority</#64748b>"
  frame:
    material: MAGENTA_STAINED_GLASS_PANE
    name: "<#020617> "
  background:
    material: GRAY_STAINED_GLASS_PANE
    name: "<#111827> "
    glow: false
  fillers:
    header:
      material: PINK_STAINED_GLASS_PANE
      name: "<#831843> "
      slots: [10, 11, 12, 14, 15, 16]
    footer:
      material: PURPLE_STAINED_GLASS_PANE
      name: "<#581c87> "
      slots: [37, 38, 39, 41, 42, 43]
  profile:
    slot: 4
    glow: true
    title: "<#fda4af><bold>Prestige Snapshot</bold></#fda4af>"
    lore:
      - "<#94a3b8>Current Prestige:</#94a3b8> <#f8fafc>{prestige}</#f8fafc>"
      - "<#94a3b8>Completion:</#94a3b8> <#fde68a>{completed}/{total}</#fde68a>"
      - "<#94a3b8>Season Points:</#94a3b8> <#67e8f9>{season_points}</#67e8f9>"
      - "<#94a3b8>Bonus Award:</#94a3b8> <#4ade80>{bonus}</#4ade80>"
      - ""
      - "<#475569>Prestige resets route progress in exchange for a stronger profile arc.</#475569>"
  readiness:
    slot: 20
    material: TOTEM_OF_UNDYING
    glow: false
    title: "<#fde68a><bold>Readiness Check</bold></#fde68a>"
    lore:
      - "<#94a3b8>Completed:</#94a3b8> <#f8fafc>{completed}/{total}</#f8fafc>"
      - "<#94a3b8>Progress:</#94a3b8> <#67e8f9>{progress}%</#67e8f9>"
      - "<#94a3b8>Status:</#94a3b8> <#f8fafc>{status}</#f8fafc>"
      - ""
      - "<#475569>Full network completion is required before prestige can fire.</#475569>"
  impact:
    slot: 22
    material: TNT
    glow: false
    title: "<#fb7185><bold>Reset Impact</bold></#fb7185>"
    lore:
      - "<#94a3b8>Advancement Progress:</#94a3b8> <#f8fafc>Reset</#f8fafc>"
      - "<#94a3b8>Challenge Reset:</#94a3b8> <#f8fafc>{challenge_reset}</#f8fafc>"
      - "<#94a3b8>Bonus Granted:</#94a3b8> <#4ade80>{bonus}</#4ade80>"
      - ""
      - "<#475569>Review this carefully before confirming the reset.</#475569>"
  rewards:
    slot: 24
    material: NETHER_STAR
    glow: true
    title: "<#86efac><bold>Prestige Yield</bold></#86efac>"
    lore:
      - "<#94a3b8>Next Prestige:</#94a3b8> <#f8fafc>{next_prestige}</#f8fafc>"
      - "<#94a3b8>Point Bonus:</#94a3b8> <#4ade80>{bonus}</#4ade80>"
      - ""
      - "<#475569>Prestige extends long-term progression after a full clear.</#475569>"
  action:
    slot: 31
    ready:
      material: EMERALD_BLOCK
      glow: true
      title: "<#4ade80><bold>Execute Prestige</bold></#4ade80>"
      lore:
        - "<#94a3b8>You have completed the full network.</#94a3b8>"
        - "<#94a3b8>Next Prestige:</#94a3b8> <#f8fafc>{next_prestige}</#f8fafc>"
        - "<#94a3b8>Bonus Award:</#94a3b8> <#4ade80>{bonus}</#4ade80>"
        - ""
        - "<#475569>Click to apply the reset and issue the prestige reward.</#475569>"
    locked:
      material: REDSTONE_BLOCK
      glow: false
      title: "<#fb7185><bold>Prestige Locked</bold></#fb7185>"
      lore:
        - "<#94a3b8>Completed:</#94a3b8> <#f8fafc>{completed}/{total}</#f8fafc>"
        - "<#94a3b8>Next Prestige:</#94a3b8> <#f8fafc>{next_prestige}</#f8fafc>"
        - ""
        - "<#475569>Finish every configured advancement before this becomes available.</#475569>"
  season:
    slot: 48
    material: RECOVERY_COMPASS
    glow: false
    title: "<#fde68a><bold>Open Season Ops</bold></#fde68a>"
    lore:
      - "<#94a3b8>Review reward thresholds and seasonal pace.</#94a3b8>"
  challenges:
    slot: 50
    material: CLOCK
    glow: false
    title: "<#67e8f9><bold>Open Challenge Board</bold></#67e8f9>"
    lore:
      - "<#94a3b8>Review daily and weekly objectives before resetting.</#94a3b8>"
  back:
    slot: 49
    material: BARRIER
    glow: false
    title: "<#fb7185><bold>Back to Command Deck</bold></#fb7185>"
    lore:
      - "<#94a3b8>Return to the main menu.</#94a3b8>"
  status:
    ready: "<#4ade80>Ready</#4ade80>"
    locked: "<#fb7185>Locked</#fb7185>"
  values:
    enabled: "<#4ade80>Enabled</#4ade80>"
    disabled: "<#94a3b8>Disabled</#94a3b8>"

